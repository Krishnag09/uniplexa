# Analytics (PostHog). Blank ⇒ events log to the console.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Booking link for the "Book a free penalty review" CTA (Cal.com / Calendly / Google).
NEXT_PUBLIC_BOOKING_URL=

# Public contact address shown in the footer and privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Lead sink. Google Apps Script Web App /exec URL (see scripts/google-sheets-lead-webhook.gs)
# or a Formspree/Basin endpoint. Blank ⇒ leads only queue in the browser.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Google Search Console verification token (the content="..." value from the
# HTML-tag verification method). Needed once, to verify the domain and submit
# the sitemap for indexing. Blank ⇒ no verification meta tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
