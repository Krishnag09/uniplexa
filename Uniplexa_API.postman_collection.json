					"name": "Set Password",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/set_password?token={{signup_token}}&new_password=newpassword123",
							"host": ["{{base_url}}"],
							"path": ["set_password"],
							"query": [
								{
									"key": "token",
									"value": "{{signup_token}}"
								},
								{
									"key": "new_password",
									"value": "newpassword123"
								}
							]
						}
					}
				},
