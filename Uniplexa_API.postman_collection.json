						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"newuser@example.com\",\n    \"user_role\": \"renter\",\n    \"building_id\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/add_user",
							"host": ["{{base_url}}"],
							"path": ["add_user"]
						}
