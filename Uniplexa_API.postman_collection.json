							"raw": "{{base_url}}/password-reset?token={{reset_token}}&new_password=newpassword123",
							"host": ["{{base_url}}"],
							"path": ["password-reset"],
							"query": [
								{
									"key": "token",
									"value": "{{reset_token}}"
								},
								{
									"key": "new_password",
									"value": "newpassword123"
								}
							]
						}
					}
