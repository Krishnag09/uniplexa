					"name": "Change Password",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/change_password?token={{auth_token}}&old_password=oldpassword123&new_password=newpassword123",
							"host": ["{{base_url}}"],
							"path": ["change_password"],
							"query": [
								{
									"key": "token",
									"value": "{{auth_token}}"
								},
								{
									"key": "old_password",
									"value": "oldpassword123"
								},
								{
									"key": "new_password",
									"value": "newpassword123"
								}
							]
						}
					}
				},
